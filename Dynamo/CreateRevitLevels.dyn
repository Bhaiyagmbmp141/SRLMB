    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "names         = [\"Ground Floor\", \"Level 1\", \"Level 2\", \"Level 3\", \"Roof\"];\nelevations_mm = [0, 3000, 6000, 9000, 12000];\nlevels        = Revit.Elements.Level.ByElevation(elevations_mm / 1000.0);\nnamed         = levels.SetParameterByName(\"Name\", names);",
