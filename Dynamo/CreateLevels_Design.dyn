          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Floor-to-floor height. Revit's internal length unit is always decimal feet, so this value is in feet even on a metric template (13.0 ft ~= 4 m)."
    },

