{
  "Uuid": "c3d4e5f6-a7b8-4901-bcde-123456789031",
  "IsCustomNode": false,
  "Description": "Creates 52 Revit Levels using a native DesignScript code block to generate elevations and names, then Level.ByElevationAndName to build the levels. No Python required. Elevation and floor-height inputs are in Revit internal units (decimal feet) regardless of the project's display units.",
  "Name": "CreateLevels_Design",
  "ElementResolver": {
    "ResolutionMap": {}
  },
