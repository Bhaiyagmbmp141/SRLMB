{
    "Uuid": "c3d0ain-0000-0000-0000-000000000001",
    "IsCustomNode": false,
    "Description": "Civil 3D \u2013 export all pipe network data (pipes + structures) to CSV with Manning's full-flow capacity per pipe.",
    "Name": "Civil3D_PipeNetworkReport",
