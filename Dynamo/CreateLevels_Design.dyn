  "Uuid": "c3d4e5f6-a7b8-4901-bcde-123456789031",
  "IsCustomNode": false,
  "Description": "Creates 52 Revit Levels using a single native DesignScript code block to generate elevations and names, then Level.ByElevationAndName to build the levels. No Python and no separate input nodes - edit the literal values at the top of the code block (count, floorHeight, baseElevation, prefix) to customize. Elevation/height values are in Revit internal units (decimal feet) regardless of the project's display units.",
  "Name": "CreateLevels_Design",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
