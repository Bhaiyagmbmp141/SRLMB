        },
        {
            "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
            "NodeType": "BooleanInputNode",
            "InputValue": true,
            "Id": "995127cb-9a5d-4d05-bdb0-a38efbeb1d87",
            "Inputs": [],
            "Outputs": [
                {
                    "Id": "01676c57-6def-43f6-8898-687c2a890038",
                    "Name": "",
                    "Description": "Boolean",
                    "UsingDefaultValue": false,
                    "Level": 2,
                    "UseLevels": false,
