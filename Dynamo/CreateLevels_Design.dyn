    },

    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "Level ",
      "Id": "00000004-0000-0000-0000-000000000001",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "00000004-0000-0000-0000-000000000002",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Name prefix. Must not collide with level names already in the project (e.g. the template's default \"Level 1\"/\"Level 2\"), or Revit will reject the duplicate name."
    },

