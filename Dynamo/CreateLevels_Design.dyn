    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "count = 52;\nfloorHeight = 13.0;\nbaseElevation = 0.0;\nprefix = \"Level \";\nindices = 0..(count - 1);\nelevations = baseElevation + indices * floorHeight;\nnames = prefix + (indices + 1);",
      "Id": "00000001-0000-0000-0000-000000000001",
