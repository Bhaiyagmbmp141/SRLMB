<Window x:Class="SRLMB.QAQC.UI.QaQcResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRLMB — Model QA/QC"
        Height="700" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: check selector -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Checks" FontWeight="Bold" Margin="0,0,0,4"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="SelectAllButton" Content="All" Width="50" Click="SelectAllButton_Click"/>
                <Button x:Name="SelectNoneButton" Content="None" Width="50" Margin="6,0,0,0" Click="SelectNoneButton_Click"/>
            </StackPanel>

            <ListBox x:Name="ChecksListBox" DockPanel.Dock="Top" Height="380">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="RunButton" DockPanel.Dock="Top" Content="Run Selected Checks" Margin="0,10,0,0" Padding="4" Click="RunButton_Click"/>
            <Button x:Name="ExportButton" DockPanel.Dock="Top" Content="Export Report..." Margin="0,6,0,0" Padding="4" Click="ExportButton_Click"/>
            <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" Margin="0,10,0,0" Padding="4" Click="CloseButton_Click"/>
        </DockPanel>

        <!-- Right: results -->
        <DockPanel Grid.Column="1">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox x:Name="ShowErrors" Content="Errors" IsChecked="True" Margin="0,0,10,0" Checked="SeverityFilterChanged" Unchecked="SeverityFilterChanged"/>
                <CheckBox x:Name="ShowWarnings" Content="Warnings" IsChecked="True" Margin="0,0,10,0" Checked="SeverityFilterChanged" Unchecked="SeverityFilterChanged"/>
                <CheckBox x:Name="ShowInfo" Content="Info" IsChecked="True" Checked="SeverityFilterChanged" Unchecked="SeverityFilterChanged"/>
                <TextBlock Text="(double-click a row to select the element in the model)" Margin="16,0,0,0" Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>

            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter Property="Background" Value="#FFFADADA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Background" Value="#FFFFF3CD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                <Setter Property="Background" Value="#FFE7F1FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="170"/>
                    <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="220"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
